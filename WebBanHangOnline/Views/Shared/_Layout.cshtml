    @*@Scripts.Render("~/bundles/jquery")*@

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const popup = document.getElementById('imageSearchPopup');
            if (!popup) return;

            // Toggle popup
            const toggleBtn = document.getElementById('toggleImageSearch');
            const closeBtn = popup.querySelector('.close-btn');
            toggleBtn?.addEventListener('click', () => popup.style.display = 'flex');
            closeBtn?.addEventListener('click', () => popup.style.display = 'none');

            // Elements
            const form = popup.querySelector('#imgSearchForm');
            const dropzone = popup.querySelector('#dropzone');
            const fileInput = popup.querySelector('#fileInput');
            const preview = popup.querySelector('#preview');
            const btnPick = popup.querySelector('#btnPick');
            const btnClear = popup.querySelector('#btnClear');

            if (!form || !dropzone || !fileInput || !preview || !btnPick || !btnClear) return;

            let pickedFile = null; // file từ paste/drag/drop/chọn

            function showPreview(file) {
                const url = URL.createObjectURL(file);
                preview.src = url;
                preview.style.display = 'block';
                btnClear.style.display = 'inline-block';
                dropzone.classList.add('has-image');
            }
            function clearPreview() {
                preview.src = '';
                preview.style.display = 'none';
                pickedFile = null;
                fileInput.value = '';
                btnClear.style.display = 'none';
                dropzone.classList.remove('has-image');
            }

            // Chọn file (reset value để chọn cùng file vẫn kích hoạt change)
            btnPick.addEventListener('click', () => {
                fileInput.value = '';       // <--- quan trọng
                fileInput.click();
            });
            dropzone.addEventListener('click', () => {
                if (!pickedFile && !fileInput.files.length) {
                    fileInput.value = '';     // <--- quan trọng
                    fileInput.click();
                }
            });
            fileInput.addEventListener('change', () => {
                if (fileInput.files && fileInput.files[0]) {
                    pickedFile = fileInput.files[0];
                    showPreview(pickedFile);
                }
            });

            // Kéo & thả
            ['dragenter', 'dragover'].forEach(ev =>
                dropzone.addEventListener(ev, e => {
                    e.preventDefault(); e.stopPropagation();
                    dropzone.style.borderColor = '#db7093';
                })
            );
            ['dragleave', 'drop'].forEach(ev =>
                dropzone.addEventListener(ev, e => {
                    e.preventDefault(); e.stopPropagation();
                    dropzone.style.borderColor = '#e3e3e3';
                })
            );
            dropzone.addEventListener('drop', e => {
                const f = e.dataTransfer.files && e.dataTransfer.files[0];
                if (f && f.type.startsWith('image/')) {
                    pickedFile = f;
                    fileInput.value = '';
                    showPreview(f);
                }
            });

            // Dán ảnh (Ctrl+V)
            window.addEventListener('paste', (e) => {
                if (!e.clipboardData) return;
                for (const item of e.clipboardData.items) {
                    if (item.type.startsWith('image/')) {
                        const f = item.getAsFile();
                        if (f) {
                            pickedFile = new File([f], 'pasted-image.png', { type: f.type || 'image/png' });
                            fileInput.value = '';
                            showPreview(pickedFile);
                            e.preventDefault();
                            break;
                        }
                    }
                }
            });

            // Xóa ảnh
            btnClear.addEventListener('click', (e) => { e.preventDefault(); clearPreview(); });

            // Submit: đưa pickedFile (nếu có) vào input file rồi để trình duyệt submit bình thường
            form.addEventListener('submit', (e) => {
                if (!pickedFile && !(fileInput.files && fileInput.files[0])) {
                    e.preventDefault();
                    alert('Vui lòng chọn hoặc dán một ảnh.');
                    return;
                }
                if (pickedFile) {
                    const dt = new DataTransfer();
                    dt.items.add(pickedFile);
                    fileInput.files = dt.files;
                    // không preventDefault: để form POST tới /search/image
                }
            });
        });
    </script>



    <script>
        // Hiện nút khi cuộn xuống
        window.addEventListener('scroll', function () {
            const btn = document.getElementById('backToTop');
            if (document.documentElement.scrollTop > 200) {
                btn.style.display = 'block';
            } else {
                btn.style.display = 'none';
            }
        });

        // Cuộn mượt lên đầu trang
        document.getElementById('backToTop').addEventListener('click', function (e) {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    </script>

