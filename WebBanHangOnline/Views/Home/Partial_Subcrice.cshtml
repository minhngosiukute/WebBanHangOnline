@model WebBanHangOnline.Models.EF.Subscribe

<div class="newsletter ">
    <div class="container ">
        <div class="row">
            <div class="col-lg-6">
                <div class="newsletter_text d-flex flex-column justify-content-center align-items-lg-start align-items-md-center text-center">
                    <h4>Đăng ký quảng cáo</h4>
                    <p>Đăng ký để nhận nhiều thông tin khuyến mãi mới nhất</p>
                </div>
            </div>
            <div class="col-lg-6">
                @using (Ajax.BeginForm("Subscribe", "Home", new AjaxOptions
                {
                    OnBegin = "OnBeginSub",
                    OnSuccess = "OnSuccessSub",
                    OnFailure = "OnFailureSub"
                }))
                {
                    @Html.AntiForgeryToken()
                    <script>
                        function OnBeginSub() {
                            console.log("Đang gửi...");
                        }

                        function OnSuccessSub(rs) {
                            if (rs.Success) {
                                alert(rs.Message || "Đăng ký thành công!");
                                document.getElementById("newsletter_email").value = "";
                            } else {
                                alert(rs.Message || "Đăng ký không thành công!");
                            }
                        }

                        function OnFailureSub(rs) {
                            alert("Có lỗi xảy ra. Vui lòng thử lại sau!");
                        }
                    </script>

                    <div class="newsletter_form d-flex flex-md-row flex-column flex-xs-column align-items-center justify-content-lg-end justify-content-center">
                        @*@Html.TextBoxFor(x => x.Email, new {})*@
                        <input id="newsletter_email" name="Email" type="email" placeholder="Nhập email của bạn" required="required" data-error="Valid email is required.">
                        <button id="newsletter_submit" type="submit" class="newsletter_submit_btn trans_300" value="Submit">Đăng ký</button>
                    </div>
                }

            </div>
        </div>
    </div>
</div>
