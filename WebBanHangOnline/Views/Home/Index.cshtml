@{
    ViewBag.Title = "MIHGO SHOP";
    ViewBag.SeoDescription = "MIHGO SHOP";
}
<link rel="stylesheet" type="text/css" href="~/Content/assets/styles/main_styles.css">
<link href="~/Content/assets/styles/Class1.css" rel="stylesheet" />

<!-- CSS cho Banner Quảng Cáo -->


<!-- Banner Quảng Cáo -->
<div class="advertisement-body" id="advertisement-body" style="display: none;">
    <div class="advertisement-banner">
        <div class="banner" id="banner">
            <button class="close-btn" onclick="closeBanner()">&times;</button>
            <h2>Giảm Giá Đặc Biệt</h2>
            <p class="discount">Giảm tới 30%</p>
            <p class="description text-dark">Khám phá các sản phẩm nội thất hiện đại, sang trọng cho ngôi nhà của bạn!</p>
            <img src="../../uploads/images/phong-khach-voi-sofa-ona.jpg" alt="Banner Nội Thất">
            <a href="/products/index" class="cta ">Mua Ngay</a>
        </div>
    </div>
</div>



<!-- Slider -->

<div class="main_slider" style="background-image: url('../../uploads/images/phong-khach-voi-sofa-ona.jpg');">
    <div class="container fill_height">
        <div class="row align-items-center fill_height">
            <div class="col">
                @*<div class="main_slider_content">
                        <h6>Spring / Summer Collection 2017</h6>
                        <h1>Get up to 30% Off New Arrivals</h1>
                        <div class="red_button shop_now_button"><a href="#">shop now</a></div>
                    </div>*@
            </div>
        </div>
    </div>
</div>

<!-- Deal of the week -->
<!-- Sale Trong Tuần -->
<div class="deal_ofthe_week">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="main_slider_content">
                    <h6>Bộ sưu tập mùa hè 2024</h6>
                    <h1>Sale 30%</h1>
                    <div  class="red_button shop_now_button"><a href="/products/index">Mua ngay</a></div>
                </div>
            </div>
            <div class="col-lg-6 text-right deal_ofthe_week_col">
                <div class="deal_ofthe_week_content d-flex flex-column align-items-center float-right">
                    <div class="section_title">
                        <h2>Sale trong tuần</h2>
                    </div>
                    <ul class="timer">
                        <li class="d-inline-flex flex-column justify-content-center align-items-center">
                            <div id="day" class="timer_num">03</div>
                            <div class="timer_unit">Day</div>
                        </li>
                        <li class="d-inline-flex flex-column justify-content-center align-items-center">
                            <div id="hour" class="timer_num">15</div>
                            <div class="timer_unit">Hours</div>
                        </li>
                        <li class="d-inline-flex flex-column justify-content-center align-items-center">
                            <div id="minute" class="timer_num">45</div>
                            <div class="timer_unit">Mins</div>
                        </li>
                        <li class="d-inline-flex flex-column justify-content-center align-items-center">
                            <div id="second" class="timer_num">23</div>
                            <div class="timer_unit">Sec</div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Banner -->
@*@Html.Action("MenuProductCategory", "Menu")*@

<!-- New Arrivals -->

<div class="new_arrivals">
    <div class="container">
        @Html.Action("MenuArrivals", "Menu")
    </div>
</div>



<!-- Best Sellers -->
<!-- Blogs -->
@Html.Action("Partial_News_Home", "News")
<!-- Benefit -->

<div class="benefit">
    <div class="container">
        <div class="row benefit_row">
            <div class="col-lg-3 benefit_col">
                <div class="benefit_item d-flex flex-row align-items-center">
                    <div class="benefit_icon"><i class="fa fa-truck" aria-hidden="true"></i></div>
                    <div class="benefit_content">
                        <h6>
                            Miễn phí vận chuyển
                        </h6>
                        <p>
                            Đăng ký
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 benefit_col">
                <div class="benefit_item d-flex flex-row align-items-center">
                    <div class="benefit_icon"><i class="fa fa-money" aria-hidden="true"></i></div>
                    <div class="benefit_content">
                        <h6>Phương thức gioa hàng</h6>
                        <p>Internet</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 benefit_col">
                <div class="benefit_item d-flex flex-row align-items-center">
                    <div class="benefit_icon"><i class="fa fa-undo" aria-hidden="true"></i></div>
                    <div class="benefit_content">
                        <h6>Hoàn trả 45 ngày </h6>
                        <p>Lưu ý</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 benefit_col">
                <div class="benefit_item d-flex flex-row align-items-center">
                    <div class="benefit_icon"><i class="fa fa-clock-o" aria-hidden="true"></i></div>
                    <div class="benefit_content">
                        <h6>Mở cửa hàng ngày </h6>
                        <p>8AM - 09PM</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    // Hiển thị banner quảng cáo khi trang được tải
    window.onload = function () {
        const bannerBody = document.getElementById("advertisement-body");
        bannerBody.style.display = "flex"; // Hiển thị banner
    };

    // Đóng banner quảng cáo
    function closeBanner() {
        const banner = document.getElementById("advertisement-body");
        banner.style.display = "none";
    }
</script>
