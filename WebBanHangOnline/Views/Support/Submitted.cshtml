@{
    ViewBag.Title = "Đã gửi yêu cầu";
    var code = ViewBag.TicketCode as string;
    var email = ViewBag.Email as string;
}
<link rel="stylesheet" type="text/css" href="~/Content/assets/styles/categories_styles.css">
<link rel="stylesheet" type="text/css" href="~/Content/assets/styles/categories_responsive.css">
<div class="alert alert-success">
    <h5>Gửi yêu cầu thành công!</h5>
    <p>Mã hỗ trợ của bạn: <strong>@code</strong></p>
    <p>Chúng tôi đã ghi nhận email: <strong>@email</strong></p>
</div>

<div class="d-flex gap-2">
    <a class="btn btn-primary" href="@Url.Action("Track","Support", new { code = code, email = email })">Theo dõi & trao đổi</a>
    <a class="btn btn-outline-secondary" href="@Url.Action("MyTickets","Support", new { email = email })">Xem tất cả yêu cầu của tôi</a>
</div>
