@{
    ViewBag.Title = "Gửi yêu cầu thành công";
}

<div class="container" style="padding-top: 40px; padding-bottom: 60px;">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm p-4 text-center">
                <div class="mb-3">
                    <span class="display-3 text-success"><i class="fa fa-check-circle"></i></span>
                </div>
                <h2>Yêu cầu đã được ghi nhận</h2>
                <p class="lead">Cảm ơn bạn đã liên hệ. Chúng tôi sẽ phản hồi qua email trong thời gian sớm nhất.</p>
                <p class="mt-3 mb-4">Mã hỗ trợ của bạn: <strong>@ViewBag.TicketCode</strong><br />
                    Vui lòng lưu lại mã này để theo dõi trạng thái xử lý.</p>
                <a href="@Url.Action("Track", "Support", new { code = ViewBag.TicketCode, email = ViewBag.Email })" class="btn btn-primary">Theo dõi yêu cầu</a>
                <a href="@Url.Action("Index", "Support")" class="btn btn-link">Gửi yêu cầu khác</a>
            </div>
        </div>
    </div>
</div>
