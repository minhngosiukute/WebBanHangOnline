@model WebBanHangOnline.Models.ViewModels.SupportTicketCreateViewModel
@{
    ViewBag.Title = "Trung tâm hỗ trợ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<meta charset="utf-8" />

<link rel="stylesheet" type="text/css" href="~/Content/assets/styles/categories_styles.css">
<link rel="stylesheet" type="text/css" href="~/Content/assets/styles/categories_responsive.css">

<div class="container" style="padding-top:160px; padding-bottom:130px;">
    <div class="row">
        <!-- ========== CỘT TRÁI: FORM GỬI YÊU CẦU (8) ========== -->
        <div class="col-md-8">
            <h2 class="mb-4">Gửi yêu cầu hỗ trợ</h2>
            <p class="text-muted">
                Hãy mô tả chi tiết vấn đề bạn gặp phải. Đội ngũ chăm sóc khách hàng sẽ phản hồi trong thời gian sớm nhất.
            </p>

            @using (Html.BeginForm("Index", "Support", FormMethod.Post, new { @class = "card p-4 shadow-sm" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(m => m.FullName)
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Nguyễn Văn A" })
                    @Html.ValidationMessageFor(m => m.FullName, null, new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Email)
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "email@domain.com" })
                    @Html.ValidationMessageFor(m => m.Email, null, new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.PhoneNumber)
                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "0987 654 321" })
                    @Html.ValidationMessageFor(m => m.PhoneNumber, null, new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Subject)
                    @Html.TextBoxFor(m => m.Subject, new { @class = "form-control", placeholder = "Ví dụ: Tôi cần hỗ trợ về đơn hàng #123" })
                    @Html.ValidationMessageFor(m => m.Subject, null, new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Message)
                    @Html.TextAreaFor(m => m.Message, 6, 50, new { @class = "form-control", placeholder = "Vui lòng cung cấp thông tin chi tiết..." })
                    @Html.ValidationMessageFor(m => m.Message, null, new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-primary btn-block">Gửi yêu cầu</button>
            }
        </div>

        <!-- ========== CỘT PHẢI: TRA CỨU & THEO DÕI (4) ========== -->
        <!-- ========== CỘT PHẢI: TRA CỨU & THEO DÕI (4) ========== -->
        <!-- CỘT PHẢI -->
        <div class="col-md-4">
            <div class="support-sticky">
                <!-- Card: Danh sách đã gửi -->
                <div class="card mt-4 mt-md-0">
                    <div class="card-header">
                        <strong>Đã gửi yêu cầu trước đó?</strong>
                    </div>
                    <div class="card-body">
                        <form method="get" action="@Url.Action("MyTickets","Support")">
                            <div class="form-group">
                                <label>Email đã dùng để gửi yêu cầu</label>
                                <input type="email" name="email" class="form-control"
                                       placeholder="nhap@email.com"
                                       value="@(Model?.Email ?? "")" required />
                            </div>
                            <button type="submit" class="btn btn-outline-primary btn-block">Xem danh sách yêu cầu</button>
                        </form>
                    </div>
                </div>

                <!-- Card: Theo dõi bằng Mã + Email -->
                <div class="card mt-3">
                    <div class="card-header">
                        <strong>Theo dõi yêu cầu</strong>
                    </div>
                    <div class="card-body">
                        <small class="text-muted d-block mb-2">
                            Nhập <em>Mã hỗ trợ</em> và <em>Email</em> để xem chi tiết và trao đổi.
                        </small>
                        <form method="get" action="@Url.Action("Track","Support")">
                            <div class="form-group">
                                <label for="code">Mã hỗ trợ</label>
                                <input type="text" id="code" name="code" class="form-control"
                                       placeholder="VD: ST-20251021-ABCD" />
                            </div>
                            <div class="form-group">
                                <label for="emailTrack">Email</label>
                                <input type="email" id="emailTrack" name="email" class="form-control"
                                       placeholder="email@domain.com"
                                       value="@(Model?.Email ?? "")" />
                            </div>
                            <button type="submit" class="btn btn-secondary btn-block">Theo dõi</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>


        <!-- /CỘT PHẢI -->
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
