@model IEnumerable<WebBanHangOnline.Models.EF.Wishlist>
@using WebBanHangOnline.Common
@{
    ViewBag.Title = "Sản phẩm yêu thích";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" type="text/css" href="~/Content/assets/styles/main_styles.css">

<style>
    /* Kéo trang lên bớt để không che nút Add to cart */
    .wishlist-slider-section {
        margin-top: 90px;
    }
    /* trước 140px */
    @@media (max-width: 575.98px) {
        .wishlist-slider-section {
            margin-top: 70px;
        }
    }

    .wishlist-slider-section .section_title {
        margin-bottom: 6px;
    }

    .product_slider_container {
        position: relative;
    }

    .product-item .red_button a {
        text-transform: none;
    }

    .wishlist-empty {
        text-align: center;
        padding: 60px 0;
    }

        .wishlist-empty i {
            font-size: 60px;
            color: #ddd;
            margin-bottom: 16px;
        }

    /* Thu gọn info để nút Add to cart không bị trôi xuống dưới fold */
    .product_info {
        padding-bottom: 0;
    }

        .product_info .product_name {
            margin-bottom: 6px;
        }

    .product_price {
        margin-top: 4px;
    }

        .product_price span {
            margin-left: 8px;
        }

    /* Nút xóa */
    .btn-wl-remove {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fe4c50;
        color: #fff;
        border-radius: 4px;
        padding: 6px 10px;
        border: none;
        cursor: pointer;
        font-size: 13px;
    }

        .btn-wl-remove:hover {
            filter: brightness(.95);
        }

    /* Loading + Toast */
    .loading {
        position: fixed;
        inset: 0;
        background: rgba(255,255,255,.7);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #f3f3f3;
        border-top: 4px solid #fe4c50;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .toast-message {
        position: fixed;
        top: 20px;
        right: 20px;
        padding: 14px 20px;
        background: #333;
        color: #fff;
        border-radius: 4px;
        display: none;
        z-index: 10000;
        box-shadow: 0 2px 10px rgba(0,0,0,.2);
    }

    .toast-success {
        background: #4CAF50;
    }

    .toast-error {
        background: #F44336;
    }

    /* Một chút khoảng cách để thấy rõ nút Add to cart */
    .product-item .red_button {
        margin-top: 6px;
    }
    /* Đẩy nội dung xuống vừa khung header */
.wishlist-slider-section { margin-top: 90px; }
@@media (max-width: 575.98px){
  .wishlist-slider-section { margin-top: 70px; }
}

/* Card sản phẩm dạng cột, ghim nút xuống đáy */
.product_slider_item { height: 100%; }
.product-item {
  display: flex;
  flex-direction: column;
  height: 100%;
}
.product-item .product {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
}
.product_info { margin-top: auto; padding-bottom: 0; }
.product_info .product_name { margin-bottom: 6px; }
.product_price { margin-top: 4px; }
.product_price span { margin-left: 8px; }

/* Nút Add to cart nằm trong thẻ */
.product-item .red_button {
  margin-top: 10px;              /* khoảng cách nhỏ phía trên */
}
.product-item .red_button a {
  display: block;
  width: 100%;
  text-transform: none;
}

/* (tuỳ chọn) giúp tất cả item cao bằng nhau trong Owl */
#wishlist_slider .owl-stage { display: flex; }
#wishlist_slider .owl-item { display: flex; }
#wishlist_slider .owl-item .product_slider_item { display: flex; width: 100%; }

</style>

<div class="wishlist-slider-section">
    <div class="container">
        <div class="row">
            <div class="col text-center">
                <div class="section_title new_arrivals_title">
                    <h2><i class="fa fa-heart" style="color:#fe4c50"></i> Sản phẩm yêu thích</h2>
                </div>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row">
                <div class="col">
                    <div class="product_slider_container">
                        <div id="wishlist_slider" class="owl-carousel owl-theme product_slider">

                            @foreach (var w in Model)
                            {
                                var p = w.Product;
                                var img = p?.ProductImage?.FirstOrDefault(x => x.IsDefault);
                                var strImg = img != null ? img.Image : (p?.Image ?? "/Content/assets/images/no-image.png");
                                var wishlist = p.Wishlists.FirstOrDefault(x => x.UserName == User.Identity.Name);
                                var isWishlist = false;
                                if (wishlist != null)
                                {
                                    isWishlist = true;
                                }

                                <div class="owl-item product_slider_item" id="wl-@w.Id" data-wlid="@w.Id" data-pid="@p.Id">
                                    <div class="product-item @p.ProductCategory.Alias">
                                        <div class="product discount product_filter">
                                            <div class="product_image">
                                                <a href="@Url.Action("Detail","Products", new { alias = p.Alias, id = p.Id })" title="@p.Title">
                                                    <img src="@strImg" alt="@p.Title" />
                                                </a>
                                            </div>

                                            @if (isWishlist == true)
                                            {
                                                <div data-id="@p.Id" class="favorite favorite_left active"></div>
                                            }
                                            else
                                            {
                                                <div data-id="@p.Id" class="favorite favorite_left"></div>
                                            }

                                            @if (p.PriceSale > 0)
                                            {
                                                <div class="product_bubble product_bubble_right product_bubble_red d-flex flex-column align-items-center">
                                                    <span>sale</span>
                                                </div>
                                            }

                                            <div class="product_info">
                                                <h6 class="product_name">
                                                    <a href="@Url.Action("Detail","Products", new { alias = p.Alias, id = p.Id })">@p.Title</a>
                                                </h6>

                                                @if (p.PriceSale > 0)
                                                {
                                                    <div class="product_price">
                                                        @Common.FormatNumber(p.PriceSale, 0)đ
                                                        <span>@Common.FormatNumber(p.Price, 0)</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="product_price">@Common.FormatNumber(p.Price, 0)đ</div>
                                                }
                                            </div>
                                        </div>

                                        <!-- NÚT ADD TO CART PHẢI Ở TRONG .product-item -->
                                        <div class="red_button add_to_cart_button">
                                            <a href="#" class="btnAddToCart" data-id="@p.Id">Thêm giỏ hàng</a>
                                        </div>
                                    </div>
                                </div>
                            }


                        </div>

                        <!-- Navigation -->
                        <div id="wishlist_nav_left" class="product_slider_nav_left product_slider_nav d-flex align-items-center justify-content-center flex-column">
                            <i class="fa fa-chevron-left" aria-hidden="true"></i>
                        </div>
                        <div id="wishlist_nav_right" class="product_slider_nav_right product_slider_nav d-flex align-items-center justify-content-center flex-column">
                            <i class="fa fa-chevron-right" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="wishlist-empty">
                <i class="fa fa-heart-o"></i>
                <h3>Bạn chưa có sản phẩm yêu thích nào</h3>
                <a href="/san-pham" class="red_button" style="display:inline-block;padding:10px 16px;border-radius:4px;">
                    <span style="color:#fff">Khám phá sản phẩm</span>
                </a>
            </div>
        }
    </div>
</div>

<!-- Loading & Toast -->
<div class="loading"><div class="spinner"></div></div>
<div class="toast-message" id="toast-message"></div>

@section scripts{
    
        <script src="~/Content/assets/js/categories_custom.js"></script>
    
}
