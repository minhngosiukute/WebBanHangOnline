@model WebBanHangOnline.Models.ExternalLoginListViewModel
@using Microsoft.Owin.Security



@{
    var loginProviders = Context.GetOwinContext().Authentication.GetExternalAuthenticationTypes();
    if (!loginProviders.Any())
    {
        <div>
            <p>
                There are no external authentication services configured.
            </p>
        </div>
    }
    else
    {
        /* ÉP area = "" để không bị route sang /Admin */
        using (Html.BeginForm(
            actionName: "ExternalLogin",
            controllerName: "Account",
            routeValues: new { ReturnUrl = Model.ReturnUrl, area = "" },
            method: FormMethod.Post,
            htmlAttributes: new { @class = "external-login-form" }))
        {
            @Html.AntiForgeryToken()

            <div id="socialLoginList" class="external-login-buttons">
                @foreach (AuthenticationDescription p in loginProviders)
                {
                    var isGoogle = p.AuthenticationType.Equals("Google", StringComparison.OrdinalIgnoreCase);
                    var caption = isGoogle ? "Đăng nhập với Google" : $"Đăng nhập với {p.Caption}";
                    var btnClass = isGoogle ? "btn btn-google" : "btn btn-default";

                    <button type="submit"
                            class="@btnClass"
                            name="provider"
                            value="@p.AuthenticationType"
                            title="@caption">
                        @if (isGoogle)
                        {<i class="fa fa-google"></i>} @caption
                    </button>
                }
            </div>
        }
    }
}

<style>
    .external-login-buttons {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: stretch;
    }

    .btn-google {
        background-color: #db4437;
        color: #fff;
        border: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 5px;
        width: 100%;
    }

        .btn-google:hover,
        .btn-google:focus {
            background-color: #c23321;
            color: #fff;
        }

    #socialLoginList .btn-default {
        width: 100%;
        padding: 10px 16px;
    }
</style>
