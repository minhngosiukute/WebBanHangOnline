@model WebBanHangOnline.Models.EditAccountViewModel
@{
    ViewBag.Title = "Cập nhật tài khoản";
}

@section naviheader{
    <!-- Left navbar links -->
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin" class="nav-link">Trang chủ</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin" class="nav-link">@ViewBag.Title</a>
        </li>
    </ul>
}
<style>
    .form-check-input {
        transform: scale(1.2);
        margin-top: 0.3rem;
    }

    .form-check-label {
        cursor: pointer;
        border-radius: 6px;
        background-color: #f8f9fa;
        transition: 0.2s;
    }

    .form-check-input:checked + .form-check-label {
        background-color: #5cb85c;
        color: white;
        border-color: #4cae4c;
    }
</style>
<!-- Main content -->
<section class="content">

    <!-- Default box -->
    <div class="card aurora-background">
        <div class="card-header">
            <h3 class="card-title">Cập nhật tài khoản</h3>

        </div>
        <div class="card-body aurora-background">
            @using (Html.BeginForm("Edit", "Account", FormMethod.Post))
            {
                @Html.ValidationSummary(false)
                @Html.AntiForgeryToken()
                <div class="form-group ">
                    <label>Tài khoản</label>
                    @Html.TextBoxFor(x => x.UserName, new { @class = "form-control",@readonly= "true" })
                </div>
                <div class="form-group">
                    <label>Họ tên</label>
                    @Html.TextBoxFor(x => x.FullName, new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <label>Email</label>
                    @Html.TextBoxFor(x => x.Email, new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <label>Phone</label>
                    @Html.TextBoxFor(x => x.Phone, new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <div class="form-group">
                        <label>Quyền</label>
                        <div class="d-flex flex-wrap gap-3">
                            @{
                                var allRoles = (ViewBag.AllRoles as IEnumerable<string>) ?? Enumerable.Empty<string>();
                            }

                            @foreach (var role in allRoles)
                            {
                                bool isChecked = Model.Roles != null && Model.Roles.Contains(role);
                                <div class="form-check mr-3 mb-2">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="role_@role"
                                           name="Roles"
                                           value="@role"
                                           @(isChecked ? "checked=\"checked\"" : "") />
                                    <label class="form-check-label badge bg-light border px-2 py-1" for="role_@role">
                                        @role
                                    </label>
                                </div>
                            }
                        </div>
                    </div>





                </div>
                
                <div class="form-group">
                    <button type="submit" class="btn btn-outline-success">Sửa</button>
                </div>
            }
        </div>
        <!-- /.card-body -->
        <div class="card-footer">

        </div>
        <!-- /.card-footer-->
    </div>
    <!-- /.card -->

</section>
<!-- /.content -->
