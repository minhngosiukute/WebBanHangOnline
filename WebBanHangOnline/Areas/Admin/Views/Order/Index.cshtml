@model PagedList.IPagedList<WebBanHangOnline.Models.EF.Order>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Danh sách đơn hàng";

    // Bind lại giá trị ngày theo dd-MM-yyyy
    string fd = ViewBag.FromDate as string;
    string td = ViewBag.ToDate as string;
    string fdVal = DateTime.TryParse(fd, out var _fd) ? _fd.ToString("dd-MM-yyyy") : fd;
    string tdVal = DateTime.TryParse(td, out var _td) ? _td.ToString("dd-MM-yyyy") : td;
}

@section naviheader {
    <!-- Left navbar links -->
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin" class="nav-link">Trang chủ</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin/order" class="nav-link">Danh sách đơn hàng</a>
        </li>
    </ul>
}

<!-- Main content -->
<section class="content">
    <!-- Default box -->
    <div class="card aurora-backrougnt">
        <div class="card-header aurora-background">
            <h3 class="card-title text-center">Danh sách đơn hàng</h3>
        </div>

        <div class="card-body aurora-background">
            @using (Html.BeginForm("Index", "Order", FormMethod.Get, new { @class = "form-inline mb-3" }))
            {
                <div class="form-group mr-2">
                    <label for="fromDate" class="mr-2">Từ ngày:</label>
                    <input type="text" id="fromDate" name="fromDate" value="@fdVal" class="form-control datepicker" autocomplete="off" />
                </div>

                <div class="form-group mr-2">
                    <label for="toDate" class="mr-2">Đến ngày:</label>
                    <input type="text" id="toDate" name="toDate" value="@tdVal" class="form-control datepicker" autocomplete="off" />
                </div>

                <div class="form-group mr-2">
                    <label for="status" class="mr-2">Trạng thái:</label>
                    <select id="status" name="status" class="form-control">
                        <option value="">-- Tất cả --</option>
                        <option value="1" @(ViewBag.Status == 1 ? "selected" : "")>Chưa thanh toán</option>
                        <option value="2" @(ViewBag.Status == 2 ? "selected" : "")>Đã thanh toán</option>
                        <option value="3" @(ViewBag.Status == 3 ? "selected" : "")>Hoàn thành</option>
                        <option value="4" @(ViewBag.Status == 4 ? "selected" : "")>Hủy</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary mr-2">Lọc</button>
                <a class="btn btn-secondary" href="@Url.Action("Index","Order", new { area="Admin" })">Xóa lọc</a>
            }

            <table class="table table-bordered table-striped table-hover">
                <thead>
                    <tr>
                        <th class="text-center">STT</th>
                        <th class="text-center">Mã đơn hàng</th>
                        <th class="text-center">Tên Khách hàng</th>
                        @*<th class="text-center">Phone</th>
                            <th class="text-center">Tiền</th>*@
                        <th class="text-center">Phương thức thanh toán</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Ngày tạo</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var i = ((ViewBag.Page - 1) * ViewBag.PageSize) + 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@i</td>
                                <td class="text-center">@item.Code</td>
                                <td class="text-center">@item.CustomerName</td>
                                @*<td class="text-center">@item.Phone</td>*@
                                @*<td class="text-center">@WebBanHangOnline.Common.Common.FormatNumber(item.TotalAmount, 0)</td>*@
                                <td class="text-center">@(item.TypePayment == 1 ? "COD" : "Chuyển khoản")</td>
                                <td class="text-center">
                                    @if (item.Status == 1)
                                    {<span class="badge badge-warning">Chưa thanh toán</span>}
                                    @if (item.Status == 2)
                                    {<span class="badge badge-info">Đã thanh toán</span>}
                                    @if (item.Status == 3)
                                    {<span class="badge badge-success">Hoàn thành</span>}
                                    @if (item.Status == 4)
                                    {<span class="badge badge-danger">Hủy</span>}
                                </td>
                                <td class="text-center">@item.CreatedDate.ToString("dd-MM-yyyy")</td>
                                <td class="text-center">
                                    <a href="/admin/order/view/@item.Id" class="btn btn-sm btn-outline-success"><i class="fas fa-eye"></i> Xem</a>
                                    <a href="#" class="btn btn-sm btn-outline-primary btnCapNhat ml-2" data-id="@item.Id"><i class="fas fa-sync-alt"></i> Cập nhật</a>
                                    <button type="button" data-id="@item.Id" class="btn btn-sm btn-outline-danger btnDelete ml-2">
                                        <i class="fas fa-trash-alt"></i> Xóa
                                    </button>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center">Không có đơn hàng nào!</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row mt-3">
                <div class="col-6"></div>
                <div class="col-6" style="text-align:right;">
                    @Html.PagedListPager(Model, page => Url.Action("Index", new
                    {
                        page,
                        status = ViewBag.Status,
                        fromDate = ViewBag.FromDate,
                        toDate = ViewBag.ToDate
                    }))
                </div>
            </div>
        </div>

        <div class="card-footer text-center"></div>
    </div>
</section>

<div class="modal fade" id="modal-default">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Cập nhật trạng thái</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="txtOrderId" value="0" />
                <div class="form-group">
                    <label>Trạng thái</label>
                    <select class="form-control" id="ddTrangThai">
                        <option value="2">Đã thanh toán</option>
                        <option value="1">Chưa thanh toán</option>
                        <option value="3">Hoàn thành</option>
                        <option value="4">Hủy</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fas fa-times"></i> Đóng</button>
                <button type="button" class="btn btn-primary" id="btnLuu"><i class="fas fa-save"></i> Lưu</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <!-- Bootstrap Datepicker (VN) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/css/bootstrap-datepicker.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/js/bootstrap-datepicker.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/locales/bootstrap-datepicker.vi.min.js"></script>

    <script>
        // Khởi tạo lịch tiếng Việt, format dd-MM-yyyy
        $(function () {
            $('.datepicker').datepicker({
                format: 'dd-mm-yyyy',
                language: 'vi',
                todayHighlight: true,
                autoclose: true,
                weekStart: 1
            });
        });

        // Check nhanh: từ ngày không lớn hơn đến ngày (dd-MM-yyyy)
        document.addEventListener('submit', function (e) {
            var f = e.target;
            if (f.action && f.action.toLowerCase().indexOf('/order/index') !== -1) {
                var from = f.fromDate ? f.fromDate.value : '';
                var to = f.toDate ? f.toDate.value : '';
                if (from && to) {
                    const [fd, fm, fy] = from.split('-').map(Number);
                    const [td, tm, ty] = to.split('-').map(Number);
                    const d1 = new Date(fy, fm - 1, fd);
                    const d2 = new Date(ty, tm - 1, td);
                    if (d1 > d2) { alert('Từ ngày không được lớn hơn Đến ngày'); e.preventDefault(); }
                }
            }
        });
    </script>

    <script>
        $(document).ready(function () {
            $('body').on('click', '.btnCapNhat', function () {
                var id = $(this).data("id");
                $('#txtOrderId').val(id);
                $('#modal-default').modal('show');
            });

            $('body').on('click', '#btnLuu', function () {
                var id = $('#txtOrderId').val();
                var tt = $('#ddTrangThai').val();
                $.ajax({
                    url: '/admin/order/UpdateTT',
                    type: 'POST',
                    data: { id: id, trangthai: tt },
                    success: function (res) {
                        if (res.Success) {
                            location.reload();
                        }
                    }
                });
            });

            $('body').on('click', '.btnDelete', function () {
                var id = $(this).data("id");
                if (confirm('Bạn có chắc chắn muốn xóa đơn hàng này không?')) {
                    $.ajax({
                        url: '/admin/order/delete',
                        type: 'POST',
                        data: { id: id },
                        success: function (rs) {
                            if (rs.success) {
                                alert("Đơn hàng đã được xóa thành công!");
                                location.reload();
                            } else {
                                alert("Có lỗi xảy ra, vui lòng thử lại!");
                            }
                        }
                    });
                }
            });
        });
    </script>
}

<style>
    /* Tùy chỉnh giao diện bảng và nút */
    .table th, .table td {
        vertical-align: middle;
    }

    .badge {
        font-size: 0.9rem;
        padding: 0.4em 0.8em;
    }

    .btn-sm {
        padding: 0.25rem 0.75rem;
        font-size: 0.875rem;
    }

    .ml-2 {
        margin-left: 0.5rem;
    }

    .mt-3 {
        margin-top: 1rem;
    }

    .btn-primary:hover {
        background-color: #0056b3 !important;
    }

    .btn-danger:hover {
        background-color: #c82333 !important;
    }

    .btn-success:hover {
        background-color: #218838 !important;
    }

    .modal-content {
        border-radius: 0.5rem;
    }

    .modal-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }

    .modal-footer .btn {
        min-width: 100px;
    }
</style>
