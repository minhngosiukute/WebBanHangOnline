@model IEnumerable<WebBanHangOnline.Models.EF.Adv>
@{
    ViewBag.Title = "Danh sách bài quảng cáo";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section naviheader{
    <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link" data-widget="pushmenu" href="#"><i class="fas fa-bars"></i></a></li>
        <li class="nav-item d-none d-sm-inline-block"><a href="/admin" class="nav-link">Trang chủ</a></li>
        <li class="nav-item d-none d-sm-inline-block"><a href="#" class="nav-link">@ViewBag.Title</a></li>
    </ul>
}

<style>
/*    .bg-gradient-pink {
        background: linear-gradient(90deg, #db7093, #ff9a9e);
    }*/

    

    .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
     
        border-radius: 6px;
        transition: all 0.2s ease-in-out;
    }

        .btn-action i {
            font-size: 14px;
        }

    .btn-warning.btn-action:hover {
        background-color: #f1c40f;
        transform: scale(1.05);
    }

    .btn-danger.btn-action:hover {
        background-color: #e74c3c;
        transform: scale(1.05);
    }

    .btn-add {
        background: #3498db;
        color: #fff !important;
        border: none;
        border-radius: 8px;
        padding: 8px 18px;
        font-weight: 500;
        transition: 0.3s ease;
    }

        .btn-add:hover {
            background: #2980b9;
            transform: scale(1.05);
        }

    /* Căn phải tuyệt đối nút thêm mới */
    .card-header {
        position: relative;
    }

        .card-header .btn-add {
            position: absolute;
            right: 20px; /* Cách mép phải 20px */
            top: 50%;
            transform: translateY(-50%);
        }
</style>

<div class="card aurora-background">
    <div class="card-header ">
        <h3 class="card-title m-0">
            <i class="fas fa-bullhorn"></i> @ViewBag.Title
        </h3>
        <a href="@Url.Action("Create", "Adv")" class="btn btn-add">
            <i class="fas fa-plus"></i> Thêm mới
        </a>
    </div>

    <div class="card-body">
        <table class="table table-bordered table-hover align-middle text-center">
            <thead>
                <tr>
                    <th>Tiêu đề</th>
                    <th>Ngày tạo</th>
                    <th width="250px">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            <a href="@Url.Action("Edit", new { id = item.Id })"
                               class="btn btn-outline-primary btn-action me-1"
                               title="Chỉnh sửa">
                                <i class="fas fa-edit"></i>
                            </a>

                            @using (Html.BeginForm("Delete", "Adv", new { id = item.Id },
                                FormMethod.Post,
                                new { onsubmit = "return confirm('Xoá bài quảng cáo này?');", style = "display:inline-block;" }))
                            {
                                <button type="submit"
                                        class="btn btn-outline-danger btn-action"
                                        title="Xóa">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
