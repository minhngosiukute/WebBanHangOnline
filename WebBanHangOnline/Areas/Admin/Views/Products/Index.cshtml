@model PagedList.PagedList<WebBanHangOnline.Models.EF.Product>
@using PagedList.Mvc
@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}



@section naviheader{
    <!-- Left navbar links -->
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin" class="nav-link">Trang chủ</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin/products" class="nav-link">@ViewBag.Title</a>
        </li>
    </ul>
}
<style>
    /* Bảng */
    table {
        width: 100%;
        border-collapse: collapse;
        table-layout: auto
    }

        table th {
            text-align: center;
            vertical-align: middle;
            padding: 8px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: clamp(14px,.9vw,14px)
        }

    /* Dialog: hiện đại, bo góc, bóng nhẹ, không padding thừa */
    #dialog {
        padding: 0
    }

    .ui-widget-overlay {
        background: #000;
        opacity: .25 !important; /* nền mờ dễ nhìn */
    }

    .ui-dialog {
        max-width: 95vw;
        max-height: 90vh;
        border: 0;
        border-radius: 12px;
        box-shadow: 0 20px 60px rgba(0,0,0,.25);
    }

        .ui-dialog .ui-dialog-titlebar {
            padding: 10px 14px;
            border: 0;
            border-radius: 12px 12px 0 0;
            background: #f6f7fb;
            font-weight: 600;
        }

        .ui-dialog .ui-dialog-titlebar-close {
            border: 0;
            background: transparent
        }

        .ui-dialog .ui-dialog-content {
            padding: 0 !important;
            overflow: hidden !important;
            background: #fff;
            border-radius: 0 0 12px 12px;
        }

    /* iFrame lấp đầy, không viền trắng */
    #myIframe {
        width: 100%;
        display: block;
        border: 0;
        height: auto
    }

    #dialog {
        padding: 0;
    }

    .ui-dialog {
        max-width: 70vw; /* ↓ từ 95vw → 70vw */
        max-height: 70vh; /* ↓ từ 90vh → 70vh */
        border: 0;
        border-radius: 10px;
    }

        .ui-dialog .ui-dialog-content {
            padding: 0 !important;
            overflow: hidden !important;
        }

    #myIframe {
        width: 100%;
        border: 0;
        display: block;
        height: auto;
    }
</style>
<style>
    /* ... style cũ ... */

    /* NEW: highlight hàng được anchor (#p123) */
    tr:target {
        outline: 2px solid #fe4c50;
        background: #fff6f6;
        transition: background .6s;
    }
</style>

<link rel="stylesheet" href="//code.jquery.com/ui/1.13.1/themes/base/jquery-ui.css">
<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Quản lý sản phẩm</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Title</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">

    <!-- Default box -->
    <div class="card aurora-background">
        <div class="card-header">
            <h3 class="card-title">@ViewBag.Title</h3>

            <div class="card-tools">
                <a href="/admin/products/add" class="btn btn-primary">Thêm mới</a>
                @*<a href="#" class="btn btn-danger" id="BtnDeleteAll">Xóa</a>*@
            </div>
        </div>
        <div class="card-body">

            <div class="row">
                <div class="col-6">
                    @using (Html.BeginForm("Index", "Products", FormMethod.Get, new { }))
                    {
                        <div class="input-group input-group-sm">
                            @Html.TextBox("SearchText", ViewBag.SearchText as string, new { @class = "form-control", placeholder = "Nhập từ khóa tìm kiếm..." })
                            <span class="input-group-append">
                                <button type="submit" class="btn btn-info btn-flat">Tìm kiếm</button>
                            </span>
                        </div>
                    }
                </div>
            </div>
            @*<div class="row">
                    <div class="col-6">
                        @using (Html.BeginForm("index", "News", FormMethod.Get, new { }))
                        {
                            <div class="input-group input-group-sm">
                                @Html.TextBox("Searchtext", new { @class = "form-control" })
                                <span class="input-group-append">
                                    <button type="submit" class="btn btn-info btn-flat">Tìm kiếm</button>
                                </span>
                            </div>
                        }
                    </div>
                </div>*@
            <table class="table table-hover text-center">
                <thead>
                    <tr>
                        @*<th><input type="checkbox" id="SelectAll" /></th>*@
                        <th>STT</th>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Số lượng</th>
                        <th>Giá</th>
                        @*<th>Ngày tạo</th>*@
                        <th>Ngày cập nhật</th>
                        <th>Home</th>
                        @*<th>Sale</th>*@
                        <th>Hiển thị</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int page = ViewBag.Page != null ? (int)ViewBag.Page : 1;
                        int pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 5;
                        int i = ((page - 1) * pageSize) + 1;


                        foreach (var item in Model)
                        {
                            var strCheck = item.IsActive ? "<i class='fa fa-check text-success'></i>" : "<i class='fas fa-times text-danger'></i>";
                            var strCheckHome = item.IsHome ? "<i class='fa fa-check text-success'></i>" : "<i class='fas fa-times text-danger'></i>";
                            //var strCheckSale = item.IsSale ? "<i class='fa fa-check text-success'></i>" : "<i class='fas fa-times text-danger'></i>";
                            var strImg = Url.Content("~/Content/assets/images/no-image.jpg"); // ảnh placeholder của bạn
                            var CheckImage = item.ProductImage.FirstOrDefault(x => x.IsDefault);
                            if (CheckImage != null && !string.IsNullOrWhiteSpace(CheckImage.Image))
                            {
                                strImg = CheckImage.Image;
                            }
                            <tr id="p@item.Id">
                                @*<td><input type="checkbox" class="cbkItem" value="@item.Id" /></td>*@
                                <td>@i</td>
                                <td>
                                    <img class="imgproduct"
                                         data-id="@item.Id"
                                         src="@strImg"
                                         width="80"
                                         style="cursor:pointer; object-fit:cover; border-radius:8px;"
                                         onerror="this.onerror=null; this.src='@Url.Content("~/Content/assets/images/no-image.jpg")';" />
                                </td>
                                <td>@item.Title</td>
                                <td>@item.ProductCategory.Title</td>
                                <td>@item.Quantity</td>
                                <td>@WebBanHangOnline.Common.Common.FormatNumber(item.Price, 0)đ</td>
                                @*<td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>*@
                                <td>@item.ModifiedDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <a href='#' data-id="@item.Id" class="btnHome">@Html.Raw(strCheckHome)</a>
                                </td>
                                @*<td class="text-center">
                                        <a href='#' data-id="@item.Id" class="btnSale">@Html.Raw(strCheckSale)</a>
                                    </td>*@
                                <td class="text-center">
                                    <a href='#' data-id="@item.Id" class="btnActive">@Html.Raw(strCheck)</a>
                                </td>
                                <td>
                                    <a href="/admin/Products/edit/@item.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i>Sửa</a>
                                    <a href="#" data-id="@item.Id" class="btn btn-sm  btn-outline-danger btnDelete ml-2"><i class="fas fa-trash-alt"></i>Xóa</a>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">Không có bản ghi nào!!!</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row">
                <div class="col-6"></div>
                <div class="col-6" style="text-align:right;">
                    @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchText = ViewBag.SearchText }))
                </div>
            </div>

        </div>
        <!-- /.card-body -->
        <div class="card-footer">

        </div>
        <!-- /.card-footer-->
    </div>
    <!-- /.card -->

</section>
<!-- /.content -->
<div id="dialog">
    <iframe id="myIframe" style="border: 0; width: 100%; height: 100%;"></iframe>
</div>
@section scripts{
    <script src="https://code.jquery.com/ui/1.13.1/jquery-ui.js"></script>
    <script>
        $(function () {

            // ---- Khởi tạo dialog (1 lần) ----
            $("#dialog").dialog({
                autoOpen: false,
                modal: true,
                resizable: true,
                draggable: true,
                title: "Quản lý ảnh sản phẩm",
                open: function () {
                    // set kích thước hợp lý lúc mở
                    resizeDialog();
                    $(".ui-dialog .ui-dialog-content").css("padding", 0);
                },
                close: function () { window.location.reload(); }
            });

            // ---- Mở dialog khi click ảnh ----
            $("body").on("click", ".imgproduct", function () {
                var proid = $(this).data("id");
                $("#myIframe").attr("src", "/admin/ProductImage/Index?id=" + proid);
                $("#dialog").dialog("open");
                return false;
            });

            // ---- Iframe load xong: bỏ margin mặc định & fit chiều cao thật ----
            $("#myIframe").on("load", function () {
                try {
                    var $doc = $(this).contents();
                    $doc.find("body").css("margin", "0"); // xoá margin 8px mặc định
                    // (tuỳ chọn) CSS gọn cho thumbnail ở trang con
                    var css = `
      /* Thumbnail gọn, không vỡ bố cục */
      .glImage{display:flex;flex-wrap:wrap;gap:10px;margin:0;padding:0;list-style:none}
      .glImage li{position:relative;display:inline-block;width:160px}   /* ↓ 220 → 160 */
      .glImage li img{width:100%;height:120px;object-fit:contain;border-radius:6px;display:block} /* ↓ 180 → 120 */
      .box-btn{position:absolute;left:6px;bottom:6px;display:flex;gap:6px}
      .card-body{padding:10px 12px 6px !important}
      .card-footer{display:none !important}
      .card{margin-bottom:0 !important}
`;

                    $doc.find("head").append("<style>" + css + "</style>");
                } catch (e) { }

                fitToIframe();
            });

            // ---- Resize theo cửa sổ ----
            $(window).on("resize", function () {
                resizeDialog();
                fitToIframe();
            });

            // ---------- Helpers ----------
            function resizeDialog() {
                var w = Math.min($(window).width() * 0.60, 800);
                var h = Math.min($(window).height() * 0.60, 600);
                $("#dialog").dialog("option", { width: w, height: h });
                $("#myIframe").height(h - titlebarHeight());
            }

            function fitToIframe() {
                var maxH = Math.min($(window).height() * 0.50, 650);
                var innerH = maxH; // fallback
                try {
                    var doc = document.getElementById("myIframe").contentWindow.document;
                    var docH = Math.max(
                        doc.body.scrollHeight, doc.documentElement.scrollHeight,
                        doc.body.offsetHeight, doc.documentElement.offsetHeight
                    );
                    innerH = Math.min(docH, maxH);
                } catch (e) { }
                $("#myIframe").height(innerH);
                $("#dialog").dialog("option", "height", innerH + titlebarHeight());
            }

            function titlebarHeight() {
                var $dlg = $("#dialog").parent();
                return $dlg.find(".ui-dialog-titlebar").outerHeight() || 0;
            }

        });
    </script>

    <!-- Các handler khác GIỮ NGUYÊN (không khởi tạo dialog lần 2) -->
    <script>
        $(document).ready(function () {
            $('body').on('click', '#BtnDeleteAll', function (e) {
                e.preventDefault();
                var str = "", i = 0;
                var checkbox = $(this).parents('.card').find('tr td input:checkbox');
                checkbox.each(function () {
                    if (this.checked) { str += (i++ === 0 ? "" : ",") + $(this).val(); }
                    else { checkbox.attr('selected', ''); }
                });
                if (str.length > 0 && confirm('Bạn có muốn xóa các bản ghi này hay không?')) {
                    $.ajax({
                        url: '/admin/news/deleteAll', type: 'POST', data: { ids: str },
                        success: function (rs) { if (rs.success) location.reload(); }
                    });
                }
            });

            $('body').on('change', '#SelectAll', function () {
                var check = this.checked;
                var cb = $(this).parents('.card-body').find('tr td input:checkbox');
                cb.each(function () { this.checked = check; cb.attr('selected', check ? 'checked' : ''); });
            });

            $('body').on('click', '.btnDelete', function () {
                var id = $(this).data("id");
                if (confirm('Bạn có muốn xóa bản ghi này không?')) {
                    $.ajax({
                        url: '/admin/Products/delete', type: 'POST', data: { id: id },
                        success: function (rs) { if (rs.success) { $('#trow_' + id).remove(); location.reload(); } }
                    });
                }
            });

            $('body').on('click', '.btnHome', function (e) {
                e.preventDefault();
                var btn = $(this), id = btn.data("id");
                $.post('/admin/Products/IsHome', { id: id }, function (rs) {
                    if (rs.success) btn.html(rs.IsHome ? "<i class='fa fa-check text-success'></i>" :
                        "<i class='fas fa-times text-danger'></i>");
                });
            });

            $('body').on('click', '.btnSale', function (e) {
                e.preventDefault();
                var btn = $(this), id = btn.data("id");
                $.post('/admin/Products/IsSale', { id: id }, function (rs) {
                    if (rs.success) btn.html(rs.IsSale ? "<i class='fa fa-check text-success'></i>" :
                        "<i class='fas fa-times text-danger'></i>");
                });
            });

            $('body').on('click', '.btnActive', function (e) {
                e.preventDefault();
                var btn = $(this), id = btn.data("id");
                $.post('/admin/Products/IsActive', { id: id }, function (rs) {
                    if (rs.success) btn.html(rs.isAcive ? "<i class='fa fa-check text-success'></i>" :
                        "<i class='fas fa-times text-danger'></i>");
                });
            });
        });
    </script>
}
