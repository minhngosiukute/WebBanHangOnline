@model PagedList.IPagedList<WebBanHangOnline.Areas.Admin.Controllers.ProductsController.BestSellingRow>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Sản phẩm bán chạy nhất";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
@section naviheader{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin/home/" class="nav-link">Trang chủ</a>
        </li>

    </ul>
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Danh sách sản phẩm yêu thích</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Danh sách sản phẩm yêu thích</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">

    <!-- Default box -->
    <div class="card aurora-background">

        <div class="card-body aurora-background">
            <div class="rank-wrapper container-fluid">
                @if (!string.IsNullOrEmpty(ViewBag.TopBestSelling))
                {
                    <p class="text-center text-danger font-weight-bold">@ViewBag.TopBestSelling</p>
                }
                @{
                    int rank = (Model.PageNumber - 1) * Model.PageSize; // tính offset nếu có phân trang
                }
                @if (!string.IsNullOrWhiteSpace(ViewBag.TopFavoriteMessage as string))
                {
                    <div class="rank-banner">@ViewBag.TopFavoriteMessage</div>
                }

                <div class="card-body">


                    <table class="table table-bordered table-hover text-center">
                        <thead style="background-color: #C6E2FF; color: black">
                            <tr>
                                <th>Hạng</th>
                                <th>Ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Danh mục</th>
                                <th>Giá</th>
                                <th>Số lượng bán</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                rank++;<!-- tăng dần theo thứ tự -->
                                <tr>
                                    <td>
                                        @if (rank == 1)
                                        {
                                            <span style="color:gold;font-weight:bold">🥇 @rank</span>
                                        }
                                        else if (rank == 2)
                                        {
                                            <span style="color:silver;font-weight:bold">🥈 @rank</span>
                                        }
                                        else if (rank == 3)
                                        {
                                            <span style="color:#cd7f32;font-weight:bold">🥉 @rank</span>
                                        }
                                        else
                                        {
                                            <span>@rank</span>
                                        }
                                    </td>

                                    <td>
                                        <img src="@Url.Content(item.Image)" alt="@item.Title"
                                             style="width:90px;height:80px;object-fit:cover;border-radius:6px" />

                                    </td>
                                    <td>@item.Title</td>
                                    <td>@item.CategoryName</td>
                                    <td>@item.Price.ToString("N0") đ</td>
                                    <td style="color:#fe4c50;font-weight:bold">@item.TotalSold</td>
                                </tr>
                            }
                        </tbody>
                    </table>




                    <div class="text-right">
                        @Html.PagedListPager(
    Model,
    page => Url.Action("BestSelling", new { page }),
    new PagedListRenderOptions
    {
        Display = PagedListDisplayMode.IfNeeded,
        MaximumPageNumbersToDisplay = 5,
        // Hai dòng dưới hỗ trợ ở PagedList.Mvc cổ điển
        UlElementClasses = new[] { "pagination" },
        LiElementClasses = new[] { "page-item" }
    }
)
                    </div>
                </div>
            </div>


        </div>

        <!-- /.card-body -->
        <!-- /.card-footer-->
    </div>
    <!-- /.card -->

</section>
<!-- /.content -->







<div class="text-center">

</div>

<style>
    /* Vì PagedList.Mvc không có PageClasses, ta style thẻ a qua CSS */
    .pagination li > a,
    .pagination li > span {
        display: inline-block;
        padding: 6px 12px;
        text-decoration: none;
    }

    .pagination li.page-item > a { /* tự xem như "page-link" */
        border: 1px solid #ddd;
        border-radius: 4px;
        margin: 0 2px;
    }

    .pagination li.active > span,
    .pagination li.active > a {
        background: #3366CC;
        color: #fff;
        border-color: #fe4c50;
    }
</style>

