@model PagedList.IPagedList<WebBanHangOnline.Models.EF.SupportTicket>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Trung tâm hỗ trợ";
}

@section naviheader {
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin" class="nav-link">Trang chủ</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="@Url.Action("Index", "SupportTickets", new { area = "Admin" })" class="nav-link">Yêu cầu hỗ trợ</a>
        </li>
    </ul>
}

<section class="content">
    <div class="card aurora-backrougnt">
        <div class="card-header aurora-background d-flex justify-content-between align-items-center">
            <h3 class="card-title">Yêu cầu hỗ trợ</h3>
            <form class="form-inline" method="get" action="@Url.Action("Index")">
                <div class="form-group mr-2">
                    @Html.DropDownList("status", new SelectList(new[] { new { Value = "", Text = "Tất cả trạng thái" } }.Concat(WebBanHangOnline.Models.EF.SupportTicketStatus.All().Select(s => new { Value = s, Text = s })), "Value", "Text", ViewBag.Status), new { @class = "form-control" })
                </div>
                <div class="form-group mr-2">
                    <input type="text" name="keyword" class="form-control" placeholder="Tìm theo mã, tên, email" value="@ViewBag.Keyword" />
                </div>
                <button type="submit" class="btn btn-primary">Lọc</button>
            </form>
        </div>
        <div class="card-body aurora-background">
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="text-center">
                        <tr >
                            <th>Mã hỗ trợ</th>
                            @*<th>Khách hàng</th>*@
                            <th>Email</th>
                            <th>Tiêu đề</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center">Chưa có yêu cầu nào.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                    <tr>
                        <td><strong>@item.TicketCode</strong></td>
                        @*<td>@item.FullName</td>*@
                        <td>@item.Email</td>
                        <td>@item.Subject</td>
                        <td class="text-center">
                            @{
                                string badgeClass = "";
                                switch (item.Status)
                                {
                                    case "Chờ xử lý":
                                        badgeClass = "badge-warning";
                                        break;
                                    case "Đang xử lý":
                                        badgeClass = "badge-danger";
                                        break;
                                    case "Đã giải quyết":
                                        badgeClass = "badge-success"; 
                                        break;
                                    case "Đã đóng":
                                        badgeClass = "badge-danger"; 
                                        break;
                                    default:
                                        badgeClass = "badge-info"; 
                                        break;
                                }
                            }
                            <span class="badge @badgeClass" style="min-width:90px; font-size:14px;">@item.Status</span>
                        </td>

                        <td>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center">
                            <a class="btn btn-sm btn-outline-success" href="@Url.Action("Details", "SupportTickets", new { area = "Admin", id = item.Id })">
                                <i class="fas fa-eye"></i>  Chi tiết
                            </a>

                            @using (Html.BeginForm("Delete", "SupportTickets", new { area = "Admin", id = item.Id }, FormMethod.Post, new { onsubmit = "return confirm('Xóa yêu cầu này? Hành động không thể hoàn tác.');", style = "display:inline-block;margin-left:6px" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fa fa-trash"></i> Xóa
                                </button>
                            }
                        </td>
                    </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer clearfix aurora-background text-right">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page, status = ViewBag.Status, keyword = ViewBag.Keyword }))
        </div>
    </div>
</section>
